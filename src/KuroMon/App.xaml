<Application x:Class="KuroMon.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:KuroMon.Converters"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Liquid design: control styles. Colors (Brush.*) are added by Themes\ThemeManager at startup. -->
        <ResourceDictionary Source="Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <conv:LevelToBrushConverter x:Key="LevelToBrush" />
      <conv:LevelToTextConverter x:Key="LevelToText" />
      <conv:OverlayLevelBrushConverter x:Key="OverlayBrush" />
      <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
      <conv:IndexToVisibilityConverter x:Key="IndexToVisibility" />
      <conv:HardwareTabKeyConverter x:Key="HardwareTabKey" />
      <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
      <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
