<Window x:Class="KuroMon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KuroMon.ViewModels"
        xmlns:models="clr-namespace:KuroMon.Models"
        xmlns:controls="clr-namespace:KuroMon.Controls"
        Title="KuroMon"
        Icon="pack://application:,,,/Assets/KuroMon.ico"
        Width="1120" Height="760" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.App}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        TextOptions.TextFormattingMode="Display">

  <!-- Custom title bar -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Status: a word in the status color; muted while everything is normal -->
    <DataTemplate x:Key="LevelChip" DataType="{x:Type vm:MetricLevel}">
      <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                 Text="{Binding Converter={StaticResource LevelToText}}"
                 Foreground="{Binding Converter={StaticResource LevelToBrush}, ConverterParameter=status}" />
    </DataTemplate>

    <!-- One reading: label, number (neutral unless it needs attention), thin gauge -->
    <DataTemplate x:Key="Reading" DataType="{x:Type vm:MetricViewModel}">
      <StackPanel>
        <Viewbox Height="44" HorizontalAlignment="Left" StretchDirection="DownOnly">
          <StackPanel Orientation="Horizontal" TextElement.FontFamily="{StaticResource Font.Display}">
            <TextBlock Text="{Binding ValueText}" FontSize="38" FontWeight="SemiBold"
                       Foreground="{Binding Level, Converter={StaticResource LevelToBrush}, ConverterParameter=text}" />
            <TextBlock Text="{Binding Unit}" FontSize="15" Margin="3,0,0,7" VerticalAlignment="Bottom"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </Viewbox>
        <ProgressBar Margin="0,6,0,0" Height="3" Maximum="100" Value="{Binding GaugeValue, Mode=OneWay}"
                     Foreground="{Binding Level, Converter={StaticResource LevelToBrush}, ConverterParameter=bar}" />
      </StackPanel>
    </DataTemplate>

    <!-- Dashboard panel: one device -->
    <DataTemplate x:Key="DevicePanelTemplate" DataType="{x:Type vm:DeviceViewModel}">
      <controls:Card Margin="5" Padding="18,14,18,14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Name, model, status -->
          <DockPanel>
            <ContentPresenter DockPanel.Dock="Right" Content="{Binding Level}" ContentTemplate="{StaticResource LevelChip}" />
            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Margin="10,0,12,0" Text="{Binding Model}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Model}"
                       Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
          </DockPanel>

          <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding UsageLabel}" Style="{StaticResource Text.Label}" Margin="0,0,0,2" />
              <ContentPresenter Content="{Binding Usage}" ContentTemplate="{StaticResource Reading}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="温度" Style="{StaticResource Text.Label}" Margin="0,0,0,2" />
              <ContentPresenter Content="{Binding Temperature}" ContentTemplate="{StaticResource Reading}" />
              <TextBlock Margin="0,5,0,0" Height="15" Text="{Binding TemperatureHint}" FontSize="11" Style="{StaticResource Text.Caption}"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding TemperatureHint}" />
            </StackPanel>
          </Grid>

          <!-- 60 s history, framed like a measuring chart -->
          <Grid Grid.Row="2" Margin="0,16,0,0" MinHeight="70">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border CornerRadius="6" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="1" ClipToBounds="True">
              <Grid>
                <controls:Sparkline Values="{Binding Usage.History}" Maximum="100" Stroke="{DynamicResource Brush.Accent}"
                                    FillOpacity="0.10" StrokeThickness="1.5" GridBrush="{DynamicResource Brush.Divider}" />
                <controls:Sparkline Values="{Binding Temperature.History}" Maximum="{Binding Temperature.ChartMax}"
                                    Stroke="{DynamicResource Brush.TextTertiary}" ShowFill="False" Dashed="True" StrokeThickness="1.25"
                                    GridBrush="Transparent" />
                <TextBlock Margin="0,3,6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Text="100%" FontSize="10"
                           Foreground="{DynamicResource Brush.TextTertiary}" />
              </Grid>
            </Border>
            <DockPanel Grid.Row="1" Margin="0,5,0,0" TextElement.FontSize="10.5" TextElement.Foreground="{DynamicResource Brush.TextTertiary}">
              <TextBlock DockPanel.Dock="Left" Text="60 秒" />
              <TextBlock DockPanel.Dock="Right" Text="0" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Rectangle Width="12" Height="1.5" VerticalAlignment="Center" Fill="{DynamicResource Brush.Accent}" />
                <TextBlock Margin="4,0,0,0" Text="使用率" />
                <Line Margin="12,0,4,0" X1="0" X2="12" VerticalAlignment="Center" StrokeThickness="1.25" StrokeDashArray="2 1.5"
                      Stroke="{DynamicResource Brush.TextTertiary}" />
                <TextBlock Text="温度 (0–110 °C)" />
              </StackPanel>
            </DockPanel>
          </Grid>

          <TextBlock Grid.Row="3" Margin="0,10,0,0" Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
                     Style="{StaticResource Text.Label}" FontSize="12.5"
                     Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}" />
        </Grid>
      </controls:Card>
    </DataTemplate>

    <!-- Detail section (label / value table) -->
    <DataTemplate x:Key="SectionTemplate" DataType="{x:Type models:InfoSection}">
      <controls:Card Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Margin="0,0,0,8" Text="{Binding Title}" TextWrapping="Wrap" Style="{StaticResource Text.Subtitle}" />
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type models:InfoItem}">
                <Grid Margin="0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" FontSize="13" VerticalAlignment="Top" />
                  <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource TextBox.Value}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </controls:Card>
    </DataTemplate>

    <!-- Settings row: text on the left, control on the right -->
    <Style x:Key="SettingRow" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,8" />
      <Setter Property="LastChildFill" Value="True" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Margin" Value="4,0,0,14" />
    </Style>

    <!-- Root grid: when maximized, WindowChrome extends past the screen edge by the resize border -->
    <Style x:Key="RootGrid" TargetType="Grid">
      <Style.Triggers>
        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
          <Setter Property="Margin" Value="7" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Style="{StaticResource RootGrid}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ================= Sidebar: the deepest layer, darkest tint ================= -->
    <Border Background="{DynamicResource Brush.SidebarTint}">
      <DockPanel Margin="12,0,12,14">
        <!-- App name (inside the caption area, so it also drags the window) -->
        <StackPanel DockPanel.Dock="Top" Height="44" Orientation="Horizontal" Margin="8,4,0,10">
          <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="18" Foreground="{DynamicResource Brush.Accent}" />
          <TextBlock Margin="10,0,0,0" Text="KuroMon" VerticalAlignment="Center" FontFamily="{StaticResource Font.Display}"
                     FontSize="17" FontWeight="SemiBold" />
        </StackPanel>

        <!-- Bottom: privilege, version, theme -->
        <StackPanel DockPanel.Dock="Bottom">
          <Border Height="1" Margin="4,0,4,10" Background="{DynamicResource Brush.Divider}" />
          <StackPanel Orientation="Horizontal" Margin="8,0,0,8">
            <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" />
            <TextBlock Margin="8,0,0,0" Text="{Binding PrivilegeText}" Style="{StaticResource Text.Caption}" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" Width="170" />
          </StackPanel>
          <DockPanel Margin="4,0,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE793;" ToolTip="テーマ切替 (ダーク / ライト)"
                    Command="{Binding ToggleThemeCommand}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE895;" ToolTip="アップデートを確認"
                    Click="OnCheckUpdateClick" />
            <TextBlock Margin="4,0,0,0" Text="{Binding VersionText}" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" />
          </DockPanel>
        </StackPanel>

        <controls:NavList x:Name="Nav" Indicator="Left" SelectedIndex="0">
          <ListBoxItem>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xEC4A;" Style="{StaticResource Icon}" />
              <TextBlock Margin="12,0,0,0" Text="ダッシュボード" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" />
              <TextBlock Margin="12,0,0,0" Text="メモリ最適化" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" />
              <TextBlock Margin="12,0,0,0" Text="ハードウェア" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" />
              <TextBlock Margin="12,0,0,0" Text="設定" />
            </StackPanel>
          </ListBoxItem>
        </controls:NavList>
      </DockPanel>
    </Border>

    <!-- ================= Right side ================= -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="44" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Caption buttons -->
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Style="{StaticResource Button.Caption}" Content="&#xE921;" ToolTip="最小化" Click="OnMinimizeClick" />
        <Button x:Name="MaxButton" Style="{StaticResource Button.Caption}" Content="&#xE922;" ToolTip="最大化" Click="OnMaximizeClick" />
        <Button Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;" ToolTip="閉じる (通知領域に格納)" Click="OnCloseClick" />
      </StackPanel>

      <!-- Notice banner -->
      <controls:Card Grid.Row="1" Margin="0,0,14,10" Padding="16,10">
        <controls:Card.Style>
          <Style TargetType="controls:Card" BasedOn="{StaticResource {x:Type controls:Card}}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </controls:Card.Style>
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Accent}" />
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Width="30" Height="30" FontSize="11" Content="&#xE711;"
                  ToolTip="閉じる" Command="{Binding DismissNoticeCommand}" />
          <Button DockPanel.Dock="Right" Margin="8,0,6,0" Style="{StaticResource Button.Accent}" Command="{Binding InstallPawnIoCommand}"
                  Visibility="{Binding PawnIoMissing, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13" />
              <TextBlock Margin="8,0,0,0" Text="インストール" />
            </StackPanel>
          </Button>
          <TextBlock Margin="12,0" VerticalAlignment="Center" Text="{Binding Notice}" Style="{StaticResource Text.Body}" />
        </DockPanel>
      </controls:Card>

      <!-- Content surface in front of the sidebar -->
      <Grid Grid.Row="2" Margin="0,0,14,14">
        <Border CornerRadius="8" Background="{DynamicResource Brush.SurfaceTint}" BorderBrush="{DynamicResource Brush.Edge}" BorderThickness="1" />

        <Grid x:Name="Pages" Margin="18,18,8,14">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- ================= Dashboard ================= -->
          <Grid x:Name="PageDashboard" Margin="0,0,10,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,4">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="オーバーレイ" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13" />
                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding OverlayEnabled}"
                              ToolTip="ゲーム中でも見える小さな常時表示バーを出します" />
                <Button Margin="16,0,0,0" Command="{Binding OptimizeMemoryCommand}" ToolTip="バックグラウンドのプロセスのメモリを解放します">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="13" />
                    <TextBlock Margin="8,0,0,0" Text="メモリを解放" FontSize="13" />
                  </StackPanel>
                </Button>
              </StackPanel>
              <TextBlock Text="ダッシュボード" Style="{StaticResource PageTitle}" />
            </DockPanel>
            <ItemsControl Grid.Row="1" Margin="-5,0" ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DevicePanelTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3" Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </Grid>

          <!-- ================= Memory optimization ================= -->
          <ScrollViewer x:Name="PageMemory" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="メモリ最適化" Style="{StaticResource PageTitle}" />

              <controls:Card Margin="0,0,0,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="メモリの状態" Style="{StaticResource Text.Section}" />
                    <StackPanel Orientation="Horizontal">
                      <StackPanel Orientation="Horizontal" TextElement.FontFamily="{StaticResource Font.Display}"
                                  TextElement.Foreground="{Binding Ram.Usage.Level, Converter={StaticResource LevelToBrush}, ConverterParameter=text}">
                        <TextBlock Text="{Binding Ram.Usage.ValueText}" FontSize="42" FontWeight="SemiBold" />
                        <TextBlock Text="%" FontSize="18" Margin="2,0,0,8" VerticalAlignment="Bottom" />
                      </StackPanel>
                      <ContentPresenter Margin="16,0,0,0" VerticalAlignment="Center"
                                        Content="{Binding Ram.Usage.Level}" ContentTemplate="{StaticResource LevelChip}" />
                    </StackPanel>
                    <ProgressBar Margin="0,8,24,0" Maximum="100" Value="{Binding Ram.Usage.GaugeValue, Mode=OneWay}"
                                 Foreground="{Binding Ram.Usage.Level, Converter={StaticResource LevelToBrush}, ConverterParameter=bar}" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding Ram.Detail}" Style="{StaticResource Text.Body}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="220">
                    <Button Height="42" Style="{StaticResource Button.Accent}" Command="{Binding OptimizeMemoryCommand}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" />
                        <TextBlock Margin="8,0,0,0" Text="今すぐメモリを解放" FontSize="15" />
                      </StackPanel>
                    </Button>
                    <ProgressBar Margin="0,10,0,0" Height="4" IsIndeterminate="True"
                                 Visibility="{Binding IsOptimizing, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                </Grid>
              </controls:Card>

              <controls:Card Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="前回の結果" Style="{StaticResource Text.Section}" />
                  <TextBlock Text="{Binding LastOptimizeText}" Style="{StaticResource Text.Body}" FontSize="15" />
                  <TextBlock Margin="0,4,0,0" Text="{Binding LastOptimizeDetail}" Style="{StaticResource Text.Caption}"
                             Visibility="{Binding LastOptimizeDetail, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
              </controls:Card>

              <controls:Card Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="ゲーム中の自動最適化" Style="{StaticResource Text.Section}" />
                  <DockPanel Style="{StaticResource SettingRow}">
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding MemoryAutoOptimize}" />
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="自動最適化モード" Style="{StaticResource Text.Body}" />
                      <TextBlock Text="全画面のゲームが前面にあり、メモリ使用率がしきい値以上のとき自動で解放します (最短 3 分間隔)。ゲーム本体は対象外です。"
                                 Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                  </DockPanel>
                  <DockPanel Style="{StaticResource SettingRow}">
                    <ComboBox DockPanel.Dock="Right" Width="120" ItemsSource="{Binding MemoryThresholdOptions}"
                              SelectedItem="{Binding SelectedMemoryThreshold}" ItemStringFormat="{}{0} %" />
                    <TextBlock Text="しきい値 (メモリ使用率)" VerticalAlignment="Center" Style="{StaticResource Text.Body}" />
                  </DockPanel>
                  <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Margin="10,0,0,0" Text="{Binding AutoStatusText}" Style="{StaticResource Text.Body}" />
                  </StackPanel>
                  <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                    <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Margin="10,0,0,0" Text="{Binding GameStatusText}" Style="{StaticResource Text.Body}" />
                  </StackPanel>
                </StackPanel>
              </controls:Card>

              <controls:Card>
                <StackPanel>
                  <TextBlock Text="解放の方法" Style="{StaticResource Text.Section}" />
                  <TextBlock Style="{StaticResource Text.Caption}" FontSize="13"
                             Text="ログオン中のユーザーのバックグラウンド プロセス (ブラウザー、チャット、ランチャーなど) の作業セットを縮小します。ページは破棄されず、必要になれば自動で戻ります。ゲーム本体、配信ソフト、Windows のシェルとシステム プロセスは対象外です。" />
                  <DockPanel Style="{StaticResource SettingRow}" Margin="0,14,0,8">
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding MemoryPurgeStandby}" />
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="スタンバイリスト (ファイル キャッシュ) も解放" Style="{StaticResource Text.Body}" />
                      <TextBlock Text="キャッシュを空けて、ゲームがすぐ使える空きメモリを増やします。直後はファイルの読み込みが一時的に遅くなることがあります。"
                                 Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                  </DockPanel>
                  <TextBlock Margin="0,12,0,6" Text="解放しないプロセス" Style="{StaticResource Text.Body}" />
                  <TextBox Text="{Binding MemoryExclusionsText, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap"
                           Tag="例: Discord, Spotify (カンマ区切り、.exe は省略可)" />
                  <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Caption}">
                    <Run Text="常に対象外: " /><Run Text="{Binding BuiltInExclusionsText, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Caption}"
                             Text="短い間隔で何度も実行すると、縮小したページを読み戻すために逆に動作が重くなることがあります。自動モードは 3 分以上の間隔を空けて実行します。" />
                </StackPanel>
              </controls:Card>
            </StackPanel>
          </ScrollViewer>

          <!-- ================= Hardware details ================= -->
          <DockPanel x:Name="PageHardware" Visibility="Collapsed" Margin="0,0,10,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <Button DockPanel.Dock="Right" VerticalAlignment="Top" Command="{Binding CopyCommand}"
                      CommandParameter="{Binding SelectedIndex, ElementName=HardwareTabs, Converter={StaticResource HardwareTabKey}}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="14" />
                  <TextBlock Margin="8,0,0,0" Text="コピー" />
                </StackPanel>
              </Button>
              <TextBlock Text="ハードウェア" Style="{StaticResource PageTitle}" Margin="4,0,0,0" />
            </DockPanel>
            <controls:NavList x:Name="HardwareTabs" DockPanel.Dock="Top" Indicator="Bottom" SelectedIndex="0" HorizontalAlignment="Left"
                                   Margin="0,0,0,12">
              <controls:NavList.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </controls:NavList.ItemsPanel>
              <ListBoxItem Padding="16,8">CPU</ListBoxItem>
              <ListBoxItem Padding="16,8">GPU</ListBoxItem>
              <ListBoxItem Padding="16,8">ディスプレイ</ListBoxItem>
              <ListBoxItem Padding="16,8">メモリ</ListBoxItem>
              <ListBoxItem Padding="16,8">マザーボード</ListBoxItem>
            </controls:NavList>
            <ProgressBar DockPanel.Dock="Top" Height="3" IsIndeterminate="True" Margin="0,0,0,12"
                         Visibility="{Binding IsLoadingDetails, Converter={StaticResource BoolToVisibility}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Grid Margin="0,0,10,0">
                <ItemsControl ItemsSource="{Binding CpuSections}" ItemTemplate="{StaticResource SectionTemplate}"
                              Visibility="{Binding SelectedIndex, ElementName=HardwareTabs, Converter={StaticResource IndexToVisibility}, ConverterParameter=0}" />
                <ItemsControl ItemsSource="{Binding GpuSections}" ItemTemplate="{StaticResource SectionTemplate}"
                              Visibility="{Binding SelectedIndex, ElementName=HardwareTabs, Converter={StaticResource IndexToVisibility}, ConverterParameter=1}" />
                <ItemsControl ItemsSource="{Binding DisplaySections}" ItemTemplate="{StaticResource SectionTemplate}"
                              Visibility="{Binding SelectedIndex, ElementName=HardwareTabs, Converter={StaticResource IndexToVisibility}, ConverterParameter=2}" />
                <StackPanel Visibility="{Binding SelectedIndex, ElementName=HardwareTabs, Converter={StaticResource IndexToVisibility}, ConverterParameter=3}">
                  <ItemsControl ItemsSource="{Binding MemorySections}" ItemTemplate="{StaticResource SectionTemplate}" />
                  <controls:Card>
                    <StackPanel>
                      <TextBlock Margin="0,0,0,8" Text="モジュール一覧" Style="{StaticResource Text.Subtitle}" />
                      <DataGrid ItemsSource="{Binding MemoryModules}" AutoGenerateColumns="False" IsReadOnly="True"
                                CanUserAddRows="False" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="スロット" Binding="{Binding Slot}" />
                          <DataGridTextColumn Header="メーカー" Binding="{Binding Manufacturer}" />
                          <DataGridTextColumn Header="型番" Binding="{Binding PartNumber}" />
                          <DataGridTextColumn Header="容量" Binding="{Binding Capacity}" />
                          <DataGridTextColumn Header="規格" Binding="{Binding Type}" />
                          <DataGridTextColumn Header="速度" Binding="{Binding Speed}" />
                          <DataGridTextColumn Header="形状" Binding="{Binding FormFactor}" Width="*" />
                        </DataGrid.Columns>
                      </DataGrid>
                    </StackPanel>
                  </controls:Card>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding MotherboardSections}" ItemTemplate="{StaticResource SectionTemplate}"
                              Visibility="{Binding SelectedIndex, ElementName=HardwareTabs, Converter={StaticResource IndexToVisibility}, ConverterParameter=4}" />
              </Grid>
            </ScrollViewer>
          </DockPanel>

          <!-- ================= Settings ================= -->
          <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="設定" Style="{StaticResource PageTitle}" />

              <controls:Card Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="一般" Style="{StaticResource Text.Section}" />
                  <DockPanel Style="{StaticResource SettingRow}">
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding AutoStartEnabled}" />
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Windows 起動時に自動起動" Style="{StaticResource Text.Body}" />
                      <TextBlock Text="サインイン後、通知領域に常駐した状態で起動します (UAC 確認なし)" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                  </DockPanel>
                  <DockPanel Style="{StaticResource SettingRow}">
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                  IsChecked="{Binding IsDarkTheme, Mode=OneWay}" Command="{Binding ToggleThemeCommand}" />
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="ダークテーマ" Style="{StaticResource Text.Body}" />
                      <TextBlock Text="Windows の「透明効果」がオフのときは、背景を半透明にせずに表示します。" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                  </DockPanel>
                </StackPanel>
              </controls:Card>

              <controls:Card Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="オーバーレイ" Style="{StaticResource Text.Section}" />
                  <DockPanel Style="{StaticResource SettingRow}">
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding OverlayEnabled}" />
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="オーバーレイを表示" Style="{StaticResource Text.Body}" />
                      <TextBlock Text="CPU / GPU / RAM の使用率と温度を、常に最前面の小さなバーで表示します。ゲームのフォーカスは奪いません。ウィンドウ / ボーダーレス表示のゲームの上に表示されます (排他的フルスクリーンでは隠れます)。ドラッグで移動できます。"
                                 Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                  </DockPanel>
                  <DockPanel Style="{StaticResource SettingRow}">
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding OverlayClickThrough}" />
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="クリックを透過する" Style="{StaticResource Text.Body}" />
                      <TextBlock Text="オーバーレイ上のクリックをゲームに通します。オンの間は移動できません。" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                  </DockPanel>
                </StackPanel>
              </controls:Card>

              <controls:Card Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="通知領域" Style="{StaticResource Text.Section}" />
                  <DockPanel Style="{StaticResource SettingRow}">
                    <ComboBox DockPanel.Dock="Right" Width="180" ItemsSource="{Binding TrayMetricOptions}"
                              SelectedItem="{Binding SelectedTrayMetric}" DisplayMemberPath="Label" />
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                      <TextBlock Text="アイコンに表示する値" Style="{StaticResource Text.Body}" />
                      <TextBlock Text="背景色: 緑 = 正常 / 黄 = 注意 / 赤 = 危険" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                  </DockPanel>
                  <DockPanel Style="{StaticResource SettingRow}">
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding HighTemperatureAlertEnabled}" />
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="高温警告の通知" Style="{StaticResource Text.Body}" />
                      <TextBlock Text="CPU / GPU が 85 °C 以上の状態が 10 秒続いたら通知します (10 分間は再通知しません)" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                  </DockPanel>
                </StackPanel>
              </controls:Card>

              <controls:Card Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="アップデート" Style="{StaticResource Text.Section}" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="200" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                        <Setter Property="Margin" Value="0,4" />
                      </Style>
                    </Grid.Resources>
                    <TextBlock Text="現在のバージョン" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock Grid.Column="1" Text="{Binding VersionText}" />
                    <TextBlock Grid.Row="1" Text="確認先リポジトリ" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UpdateRepositoryText}" />
                    <TextBlock Grid.Row="2" Text="認証" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UpdateAuthText}" />
                    <TextBlock Grid.Row="3" Text="状態" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding UpdateStatusText}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                          <Setter Property="Margin" Value="0,4" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding UpdateStatusIsProblem}" Value="True">
                              <!-- A binding, not the brush itself: Style setters freeze their values, and the shared status brushes must stay recolorable -->
                              <Setter Property="Foreground" Value="{Binding Source={x:Static vm:MetricLevel.Critical}, Converter={StaticResource LevelToBrush}}" />
                              <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Row="4" Text="トークン有効期限" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TokenExpiryText}" />
                    <TextBlock Grid.Row="5" Text="最終確認" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastUpdateCheckText}" />
                  </Grid>
                  <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Caption}"
                             Text="起動時と 6 時間ごとに確認します (問題がある間は 15 分ごと)。確認先は既定で公開リポジトリです。変更する場合は exe と同じフォルダの .env または環境変数で設定します。" />
                  <Button Margin="0,12,0,0" HorizontalAlignment="Left" Command="{Binding CheckUpdateCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="14" />
                      <TextBlock Margin="8,0,0,0" Text="今すぐ確認" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </controls:Card>

              <controls:Card>
                <StackPanel>
                  <TextBlock Text="情報" Style="{StaticResource Text.Section}" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="200" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                        <Setter Property="Margin" Value="0,4" />
                      </Style>
                    </Grid.Resources>
                    <TextBlock Text="実行ファイル" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock Grid.Column="1" Text="{Binding ExePathText}" />
                    <TextBlock Grid.Row="1" Text="ログフォルダ" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LogDirectoryText}" />
                    <TextBlock Grid.Row="2" Text="PawnIO ドライバー" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PawnIoStatusText}" />
                  </Grid>
                  <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <Button Command="{Binding OpenLogFolderCommand}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14" />
                        <TextBlock Margin="8,0,0,0" Text="ログフォルダを開く" />
                      </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" Command="{Binding InstallPawnIoCommand}"
                            Visibility="{Binding PawnIoMissing, Converter={StaticResource BoolToVisibility}}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14" />
                        <TextBlock Margin="8,0,0,0" Text="PawnIO をインストール" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </controls:Card>
            </StackPanel>
          </ScrollViewer>

          <!-- Status line -->
          <DockPanel Grid.Row="1" Margin="4,10,10,0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding LastUpdatedText}" Style="{StaticResource Text.Label}" />
            <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" Style="{StaticResource Text.Label}" />
            <TextBlock Margin="16,0" Text="{Binding AutoStatusText}" Style="{StaticResource Text.Label}" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Grid>

        <!-- Toast: a small light glass plate in front of everything -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,44" Padding="16,10" CornerRadius="8"
                Background="{DynamicResource Brush.Menu}" BorderBrush="{DynamicResource Brush.Edge}" BorderThickness="1"
                Visibility="{Binding Snackbar.IsOpen, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="False">
          <TextBlock Text="{Binding Snackbar.Message}" Style="{StaticResource Text.Body}" />
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
