<Window x:Class="KuroMon.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KuroMon.ViewModels"
        Title="KuroMon Overlay" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="{StaticResource AppFont}">
  <!--
    Deliberately theme-independent: a dark translucent bar stays readable over any game.
    Values use the status colors; labels are white.
  -->
  <Border x:Name="Root" CornerRadius="12" Padding="12,6" BorderThickness="1"
          MouseLeftButtonDown="OnDragStart" ToolTip="ドラッグで移動 / 右クリックでメニュー">
    <!-- Dark glass: slight gloss at the top, thin light edge fading downwards -->
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E3222226" Offset="0" />
        <GradientStop Color="#D9141417" Offset="0.5" />
      </LinearGradientBrush>
    </Border.Background>
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#52FFFFFF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="1" />
      </LinearGradientBrush>
    </Border.BorderBrush>
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="クリックを透過する（移動できなくなります）" Click="OnClickThroughClick" />
        <MenuItem Header="オーバーレイを閉じる" Click="OnCloseClick" />
      </ContextMenu>
    </Border.ContextMenu>
    <ItemsControl ItemsSource="{Binding Devices}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
          <StackPanel Orientation="Horizontal" Margin="6,0,10,0">
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="#B3FFFFFF" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0" />
            <TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="Bold"
                       Foreground="{Binding Usage.Level, Converter={StaticResource OverlayBrush}}">
              <Run Text="{Binding Usage.ShortText, Mode=OneWay}" /><Run Text="%" FontSize="12" />
            </TextBlock>
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="20" FontWeight="Bold"
                       Foreground="{Binding Temperature.Level, Converter={StaticResource OverlayBrush}}"
                       Visibility="{Binding Temperature.IsAvailable, Converter={StaticResource BoolToVisibility}}">
              <Run Text="{Binding Temperature.ShortText, Mode=OneWay}" /><Run Text="°C" FontSize="12" />
            </TextBlock>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Border>
</Window>
