# Copy this file to ".env" and place it next to KuroMon.exe (or set these as Windows environment variables).
# Never commit the real .env file. Changes are picked up automatically (no restart needed).

# GitHub repository that hosts release .exe files (format: owner/repo).
# Optional: when empty, the default Irony-s9c/KuroMon is used.
KUROMON_UPDATE_REPO=

# Optional. Only needed if the release repository is private:
# read-only fine-grained token (Repository access: only the release repository / Permissions: Contents = Read-only).
KUROMON_GITHUB_TOKEN=
